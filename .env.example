# ─── Configurações do Microsoft OAuth ──────────────────────────────────
# Ao rodar no servidor interno, altere o IP/Domínio abaixo:
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://192.168.X.X:3000/api/auth/microsoft/callback

# ─── Caminho do Banco de Dados (dentro do container Docker) ────────────
DB_PATH=/app/database

# ─── Configurações de E-mail (SMTP) ───────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seuemail@empresa.com
SMTP_PASS=sua_senha_ou_app_password
SMTP_FROM=TermoEP <seuemail@empresa.com>
